        "id": "dd2d7d71bd61d019",
        "type": "function",
        "z": "33c3a2507dd0fc0c",
        "name": "function 1",
        "func": "var tep = flow.get('temp');\nvar hra = flow.get('hranice');\nvar top = flow.get('topeni');\n\n\nif(top == 'zapnuto') msg.payload = 'zapnuto';\nif(top == 'vypnuto') msg.payload = 'vypnuto';\nif(top == 'automat')\n{\n    if(tep < hra){\n        msg.payload = 'automat - zapnuto';\n    }\n    else msg.payload = 'automat - vypnuto';\n} \nreturn msg;\n",
